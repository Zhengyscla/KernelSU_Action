# SM-T560NU (gtelwifiue / msm8916), LineageOS 20, Linux 3.10.108
#
# KernelSU: backslashxx 是唯一支持 32 位 ARM 的分支，使用
# CONFIG_KSU_TAMPER_SYSCALL_TABLE，不依赖 kprobes 或手工 hooks。
#
# 产物只有两个：编译出的 zImage 和基于原版 boot.img 重打包的 boot.img。
# 原版 boot.img 在内核后追加了 1MiB QCDT 设备树和 SEANDROIDENFORCE 尾部，
# 必须原样保留，否则内核找不到 DTB、静默不启动。

KERNEL_SOURCE=https://github.com/retiredtab/android_kernel_samsung_msm8916
KERNEL_SOURCE_BRANCH=lineage-20.0

ARCH=arm
KERNEL_IMAGE_NAME=zImage
KERNEL_CONFIG=msm8916_sec_defconfig

# 原版内核由 AOSP GCC 4.9 编译；使用 LineageOS 镜像的完整 4.9 工具链。
# CROSS_COMPILE / CC / KCFLAGS 由 scripts/toolchain.sh 与 build.sh 自动处理。
USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9
CUSTOM_GCC_32_BRANCH=lineage-19.1
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

EXTRA_CMDS=VARIANT_DEFCONFIG=msm8916_sec_gtelwifi_usa_defconfig SELINUX_DEFCONFIG=selinux_defconfig
USE_LLVM=false
ENABLE_GCC_ARM32=true

# --- KernelSU（Actions 界面可覆盖为 none / backslashxx）---
KSU_VARIANT=backslashxx
# 建议填具体 commit/tag；留空跟随 master。
KSU_REF=

# 3.10 没有 path_umount()，KernelSU 卸载自己的挂载点需要它。
ENABLE_PATH_UMOUNT=true

# --- boot.img ---
# 基于仓库里的原版 boot.img 重打包，保留 QCDT 和 SEANDROIDENFORCE。
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=boot/boot.img
