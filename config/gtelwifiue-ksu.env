# 实验配置：SM-T560NU（gtelwifiue / msm8916）+ KernelSU
#
# 目标内核是 Linux 3.10.108，低于 KernelSU 官方支持下限（4.14+），所以这是一条
# 实验路线，不保证能开机/可用。选择 backslashxx 分支的原因：
#   - 它是少数在 arch.h 里显式支持 32 位 ARM（__arm__）的 fork；
#   - CONFIG_KSU_TAMPER_SYSCALL_TABLE 的 Kconfig 说明为 "Verified on 3.0 ~ 7.1,
#     recommended for 3.0 ~ 4.14"，不需要 kprobes，也不需要在 fs/*.c 里手工插 hook。
#
# 已知限制：
#   - 本内核树没有 fs/overlayfs，KernelSU 的 systemless 模块（挂载）不可用；
#     只求 root/su 可以，模块页面会失败。
#   - susfs4ksu 没有 3.10 分支，ENABLE_SUSFS 必须保持 false。
#   - 管理器 APK 需要与所选 fork 匹配；刷机前请保留可用的基线内核。

KERNEL_SOURCE=https://github.com/retiredtab/android_kernel_samsung_msm8916
KERNEL_SOURCE_BRANCH=lineage-20.0

ARCH=arm
KERNEL_IMAGE_NAME=zImage
KERNEL_CONFIG=msm8916_sec_defconfig

# ARM32 工具链：DooMLoRD GCC 4.8（与基线一致）。
# CROSS_COMPILE 与 CC 由 scripts/toolchain.sh 自动推导，不要在这里写死 runner 路径。
USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=https://github.com/DooMLoRD/android_prebuilt_toolchains.git
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# SELinux 是 KernelSU 的运行前提（backslashxx 的 Kconfig 依赖 SECURITY_SELINUX）。
EXTRA_CMDS=VARIANT_DEFCONFIG=msm8916_sec_gtelwifi_usa_defconfig SELINUX_DEFCONFIG=selinux_defconfig
USE_LLVM=false
ENABLE_GCC_ARM32=true
# GCC 构建下 build.sh 不会套 ccache，这个开关对该配置无效。
ENABLE_CCACHE=false

# --- KernelSU ---
KSU_VARIANT=backslashxx
# 建议改成具体 commit/tag 以固定版本；留空会跟随 master。
KSU_REF=
# 用 syscall table tamper：不走 kprobes，也不执行 patches/legacy_ksu_hooks.sh。
KSU_HOOK_MODE=none
EXTRA_DEFCONFIG=CONFIG_KSU_TAMPER_SYSCALL_TABLE=y

# 3.10 没有 path_umount()；backslashxx 以 __weak 引用它，回移不会冲突。
ENABLE_PATH_UMOUNT=true

# 内核树里没有 fs/overlayfs，打开也只是空操作，保持关闭以明示限制。
ADD_OVERLAYFS_CONFIG=false
ENABLE_SUSFS=false
ENABLE_KPM=false

ANYKERNEL3=true
USE_CUSTOM_ANYKERNEL3=true
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/Zhengyscla/AnyKernel3-repackkernel
CUSTOM_ANYKERNEL3_BRANCH=smt560nu
