KERNEL_SOURCE=https://github.com/retiredtab/android_kernel_samsung_msm8916
KERNEL_SOURCE_BRANCH=lineage-20.0

ARCH=arm
KERNEL_IMAGE_NAME=zImage
KERNEL_CONFIG=msm8916_sec_defconfig

# 使用自定义 GCC
USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=https://github.com/DooMLoRD/android_prebuilt_toolchains.git
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

EXTRA_CMDS=VARIANT_DEFCONFIG=msm8916_sec_gtelwifi_usa_defconfig CROSS_COMPILE=/home/runner/work/KernelSU_Action/KernelSU_Action/kernel_workspace/gcc-32/arm-linux-androideabi-4.8/bin/arm-linux-androideabi- CC=/home/runner/work/KernelSU_Action/KernelSU_Action/kernel_workspace/gcc-32/arm-linux-androideabi-4.8/bin/arm-linux-androideabi-gcc KCFLAGS="-mtune=cortex-a7"
USE_LLVM=false
ENABLE_GCC_ARM32=true
ENABLE_CCACHE=true


# KSU_VARIANT=backslashxx
KSU_VARIANT=none
# 可以留空让它自动选合适版本，也可以指定分支
# KSU_REF=master

# 其他推荐
ENABLE_CCACHE=true
ANYKERNEL3=true
