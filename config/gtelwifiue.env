KERNEL_SOURCE=https://github.com/retiredtab/android_kernel_samsung_msm8916
KERNEL_SOURCE_BRANCH=lineage-20.0

ARCH=arm
KERNEL_IMAGE_NAME=zImage
KERNEL_CONFIG=msm8916_sec_defconfig

# 使用自定义 GCC
USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-eabi-4.8/+archive/refs/heads/android-msm-hammerhead-3.4-kitkat-mr2.tar.gz
CUSTOM_GCC_32_BIN=arm-eabi-

EXTRA_CMDS=VARIANT_DEFCONFIG=msm8916_sec_gtelwifi_usa_defconfig CROSS_COMPILE=arm-eabi- CC=arm-eabi-gcc

USE_LLVM=false
ENABLE_GCC_ARM32=true
ENABLE_CCACHE=true


# KSU_VARIANT=backslashxx
KSU_VARIANT=none
# 可以留空让它自动选合适版本，也可以指定分支
# KSU_REF=master

# 其他推荐
ENABLE_CCACHE=true
ANYKERNEL3=true
