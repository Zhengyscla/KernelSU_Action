# 内核源码
KERNEL_SOURCE=https://github.com/retiredtab/android_kernel_samsung_msm8916
KERNEL_SOURCE_BRANCH=lineage-20.0

# 架构与镜像
ARCH=arm
KERNEL_IMAGE_NAME=zImage

# defconfig（根据设备树确认，gtelwifiue 常用这个）
KERNEL_CONFIG=msm8916_sec_defconfig
EXTRA_CMDS=VARIANT_DEFCONFIG=msm8916_sec_gtelwifi_usa_defconfig CROSS_COMPILE=/home/runner/work/KernelSU_Action/KernelSU_Action/kernel_workspace/gcc-32/bin/arm-linux-androideabi- CC=/home/runner/work/KernelSU_Action/KernelSU_Action/kernel_workspace/gcc-32/bin/arm-linux-androideabi-gcc

# 工具链（3.10 推荐用老的 GCC）
USE_LLVM=false
ENABLE_GCC_ARM32=true
# USE_GCC=true
# GCC_VERSION=4.9   # 或 4.8，根据实际能编译成功的版本调整

# KernelSU 相关
# KSU_VARIANT=backslashxx
KSU_VARIANT=none
# 可以留空让它自动选合适版本，也可以指定分支
# KSU_REF=master

# 其他推荐
ENABLE_CCACHE=true
ANYKERNEL3=true
